# ===================================================================
# FloatChat Environment Configuration Template
# Copy this file to .env and fill in environment-specific values.
# DO NOT commit actual credentials or secret keys to version control.
# ===================================================================

# -------------------------------------------------------------------
# LLM Provider Configuration
# Supported values for LLM_PROVIDER: "ollama" (primary local) or "gemini" (cloud fallback)
# -------------------------------------------------------------------
LLM_PROVIDER=ollama

# Ollama Local Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct
OLLAMA_TIMEOUT_SECONDS=30.0

# Gemini Cloud Configuration (Required only if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=30.0

# -------------------------------------------------------------------
# PostgreSQL + PostGIS + pgvector Database Configuration
# -------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=floatchat_db
POSTGRES_USER=floatchat_user
POSTGRES_PASSWORD=your_secure_password_here

# Dedicated Read-Only Database User for Python AI Query Engine (F11 Hardening)
POSTGRES_READONLY_USER=floatchat_ai_user
POSTGRES_READONLY_PASSWORD=your_secure_readonly_password_here

# Statement Timeout (in milliseconds, default: 5000ms = 5s)
POSTGRES_STATEMENT_TIMEOUT_MS=5000

# -------------------------------------------------------------------
# Vector Search & RAG Configuration (pgvector)
# Supported values for EMBEDDING_PROVIDER: "ollama" (primary local) or "local" (alias for ollama)
# -------------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EXPECTED_EMBEDDING_DIMENSION=768
VECTOR_TOP_K=4
VECTOR_SIMILARITY_THRESHOLD=0.70

# -------------------------------------------------------------------
# FastAPI Service Configuration
# -------------------------------------------------------------------
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
FASTAPI_ENV=development
LOG_LEVEL=INFO

# -------------------------------------------------------------------
# Spring Boot Backend Configuration
# -------------------------------------------------------------------
APP_DB_HOST=127.0.0.1
APP_DB_PORT=5433
APP_DB_NAME=floatchat_app
APP_DB_USER=floatchat_app_user
APP_DB_PASSWORD=your_secure_app_password_here
APP_AI_MODE=real
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_CONNECT_TIMEOUT_MS=3000
AI_SERVICE_READ_TIMEOUT_MS=150000

# -------------------------------------------------------------------
# Service-to-Service Security & Authentication (F11 Hardening)
# -------------------------------------------------------------------
FLOATCHAT_INTERNAL_SECRET=your_shared_internal_secret_at_least_32_bytes_here
JWT_SECRET=your_jwt_signing_secret_at_least_32_bytes_here
