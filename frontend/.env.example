# ==============================================================================
# FloatChat Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local to customize local development settings.
# In development, Vite automatically proxies /api to http://localhost:8080.
# Leave VITE_API_BASE_URL empty when relying on the Vite proxy (recommended).

# Backend API Base URL (optional for dev; required for standalone production builds)
# Example: http://localhost:8080
VITE_API_BASE_URL=

